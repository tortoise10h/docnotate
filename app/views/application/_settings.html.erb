<% editor_pref = local_assigns[:editor_preference] || @editor_preference %>
<% extra_class = local_assigns[:extra_class] %>
<div class="home-settings <%= extra_class %>" data-controller="settings">
  <button class="home-settings__button"
          data-settings-target="button"
          data-action="click->settings#toggle"
          type="button"
          aria-label="Settings"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-tooltip="Settings">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>

  <div class="home-settings__panel" data-settings-target="panel" hidden>
    <div class="home-settings__header">
      <span class="home-settings__heading">Settings</span>
    </div>

    <div class="home-settings__section">
      <label class="home-settings__label">Theme</label>
      <div class="home-settings__theme-options" role="group" aria-label="Color theme selection">
        <button type="button"
                class="home-settings__theme-btn <%= "home-settings__theme-btn--active" if theme_preference == "system" %>"
                data-theme-value="system"
                data-action="click->theme#setTheme"
                aria-pressed="<%= theme_preference == "system" %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          <span>System</span>
        </button>

        <button type="button"
                class="home-settings__theme-btn <%= "home-settings__theme-btn--active" if theme_preference == "light" %>"
                data-theme-value="light"
                data-action="click->theme#setTheme"
                aria-pressed="<%= theme_preference == "light" %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <span>Light</span>
        </button>

        <button type="button"
                class="home-settings__theme-btn <%= "home-settings__theme-btn--active" if theme_preference == "dark" %>"
                data-theme-value="dark"
                data-action="click->theme#setTheme"
                aria-pressed="<%= theme_preference == "dark" %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <span>Dark</span>
        </button>
      </div>
    </div>

    <hr class="home-settings__divider">

    <%= form_with url: settings_editor_path, method: :post, class: "home-settings__form", data: { settings_target: "form", action: "submit->settings#save" } do |form| %>
      <%= form.label :editor_name, "Open in editor app", class: "home-settings__label" %>
      <%= form.text_field :editor_name, value: (editor_pref if editor_pref.present? && editor_pref != EditorOpener::DEFAULT), placeholder: "e.g. Visual Studio Code", class: "home-settings__input input", autocomplete: "off", data: { settings_target: "input" } %>
      <p class="home-settings__hint">App used when opening a file in your local editor. Choose "Use default app" to use your system default.</p>
      <p class="home-settings__error" data-settings-target="error" hidden></p>
      <div class="home-settings__actions">
        <button type="submit" name="editor_name" value="" class="button button--secondary">Use default app</button>
        <button type="submit" class="button">Save</button>
      </div>
    <% end %>
  </div>
</div>
