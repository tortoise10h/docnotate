<section id="previous-comments" class="document__archived">
  <h2 class="document__archived-title">Previous comments (<%= archived_comments_by_version.values.sum(&:size) %>)</h2>

  <% archived_comments_by_version.each do |version, comments| %>
    <div class="document__archived-version">
      <h3 class="document__archived-version-name"><%= version.version %></h3>
      <span class="document__archived-version-line" aria-hidden="true"></span>

      <% all_resolved = comments.all?(&:is_resolved) %>
      <%= form_with url: document_version_resolver_path(document), method: :patch, data: { turbo_stream: true } do |f| %>
        <%= f.hidden_field :document_version_id, value: version.id %>
        <%= f.hidden_field :resolved, value: all_resolved ? "0" : "1" %>
        <button type="submit"
                class="document__archived-version-checkall <%= "document__archived-version-checkall--resolved" if all_resolved %>"
                aria-label="<%= all_resolved ? "Undo resolve all" : "Resolve all" %>">
          <% if all_resolved %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/></svg>
          <% else %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/></svg>
          <% end %>
        </button>
      <% end %>
    </div>

    <div class="document__archived-list">
      <% comments.each do |comment| %>
        <div class="document__archived-comment <%= "document__archived-comment--resolved" if comment.is_resolved %>">
          <div class="document__archived-comment-timeline">
            <span class="document__archived-comment-dot"></span>
          </div>

          <div class="document__archived-comment-content">
            <div class="document__archived-comment-header">
              <div class="document__archived-comment-meta">
                <span><%= comment.created_at.to_fs(:short) %></span>

                <% if comment.is_resolved %>
                  <span class="document__archived-comment-badge">Resolved</span>
                <% end %>
              </div>

              <%= button_to document_comment_resolver_path(document, comment),
                            method: :patch,
                            class: "document__archived-comment-resolve",
                            aria: { label: comment.is_resolved ? "Undo resolve" : "Resolve" },
                            form: { data: { turbo_stream: true } } do %>
                <% if comment.is_resolved %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/></svg>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/></svg>
                <% end %>
              <% end %>
            </div>

            <blockquote class="document__archived-comment-quote">
              &ldquo;<%= comment.selected_text %>&rdquo;
            </blockquote>

            <div class="document__comment-markdown document__archived-comment-body"><%= comment.rendered_content %></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
