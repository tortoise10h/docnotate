<%= turbo_stream.replace "comment_payload_source" do %>
  <%= render "comments/payload_source", comment_payload: @comment_payload %>
<% end %>

<%= turbo_stream.replace "previous-comments" do %>
  <%= render "comments/archived", document: @document, archived_comments_by_version: @archived_comments_by_version %>
<% end %>

<% if @edit_error.present? %>
  <%= turbo_stream.update "comment_edit_error", @edit_error %>
<% else %>
  <%= turbo_stream.update "comment_edit_error", "" %>
<% end %>

<%= turbo_stream.action :reload_comments, "document_paper" %>
