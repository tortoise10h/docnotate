<% copy_label = document.org? ? "Copy raw org" : "Copy raw markdown" %>
<button class="icon-button icon-button--tooltip-end document__copy-button"
        data-controller="clipboard"
        data-clipboard-source-selector-value="#document_source_content"
        data-action="click->clipboard#copy"
        type="button"
        aria-label="<%= copy_label %>"
        data-tooltip="<%= copy_label %>">
  <svg class="document__copy-icon" data-clipboard-target="defaultIcon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>
  <svg class="document__copy-icon document__copy-icon--hidden" data-clipboard-target="successIcon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
</button>
