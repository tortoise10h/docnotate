<dialog class="mermaid-modal" data-mermaid-modal-target="dialog"
        data-action="click->mermaid-modal#backdropClick close->mermaid-modal#cleanup"
        aria-label="Diagram wide view">
  <div class="mermaid-modal__header">
    <span class="mermaid-modal__title">Diagram</span>
    <button class="icon-button icon-button--sm" data-action="click->mermaid-modal#close"
            data-tooltip="Close" type="button" aria-label="Close wide view">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="mermaid-modal__canvas" data-mermaid-modal-target="canvas"></div>
</dialog>
