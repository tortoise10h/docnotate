<%= form_with url: document_comments_path(document), class: "document__selection-form", data: { text_selection_target: "form" } do |f| %>
  <%= f.hidden_field :start_block_id, data: { text_selection_target: "startBlockId" } %>
  <%= f.hidden_field :end_block_id, data: { text_selection_target: "endBlockId" } %>
  <%= f.hidden_field :start_offset, data: { text_selection_target: "startOffset" } %>
  <%= f.hidden_field :end_offset, data: { text_selection_target: "endOffset" } %>
  <%= f.hidden_field :selected_text, data: { text_selection_target: "selectedText" } %>
  <%= f.hidden_field :prefix_text, data: { text_selection_target: "prefixText" } %>
  <%= f.hidden_field :postfix_text, data: { text_selection_target: "postfixText" } %>
  <div class="document__selection-toolbar" data-text-selection-target="button">
    <button class="document__selection-button" data-action="click->text-selection#showCommentInput" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      Add Note
    </button>
    <button class="document__selection-copy-button"
            data-controller="selection-copy"
            data-selection-copy-text-value=""
            data-text-selection-target="copyButton"
            data-action="click->selection-copy#copy"
            type="button"
            aria-label="Copy selected text">
      <svg class="document__selection-copy-icon" data-selection-copy-target="defaultIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>
      <svg class="document__selection-copy-icon document__selection-copy-icon--hidden" data-selection-copy-target="successIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  </div>
  <div class="document__comment-card" data-text-selection-target="commentInput">
    <%= f.text_area :content, placeholder: "Add your comment here...", class: "document__comment-textarea", id: "comment_create_text", data: { text_selection_target: "commentText", controller: "auto-resize-textarea", action: "input->auto-resize-textarea#resize" } %>
    <p class="document__comment-create-error" id="comment_create_error"></p>
    <div class="document__comment-actions">
      <button type="button" class="document__comment-cancel" data-action="click->text-selection#cancel">Cancel</button>
      <%= f.button type: "submit", class: "button", data: { controller: "hotkey", hotkey: "Mod+Enter", hotkey_scope: "comment_create_text" } do %>
        <span>Comment</span>
        <kbd class="button__hotkey-hint" data-hotkey-target="hint"></kbd>
      <% end %>
    </div>
  </div>
<% end %>
