<div id="<%= dom_id(document, :title) %>" class="document__title-wrapper" data-controller="rename">
  <div class="document__title-display" data-rename-target="display">
    <h1 class="document__title"
        data-tooltip="<%= document.file_path %>"
        data-action="click->scroll-to-top#scrollToTop dblclick->rename#edit">
      <%= document.display_name %>
    </h1>
    <% if document.current_version %>
      <span class="document__version"><%= document.current_version.version %></span>
    <% end %>
    <button class="icon-button"
            data-controller="clipboard hotkey"
            data-clipboard-text-value="<%= document.file_path %>"
            data-action="click->clipboard#copy"
            data-hotkey="Mod+Shift+l,Mod+Shift+L"
            data-tooltip="Copy file path (⇧⌘L)"
            type="button"
            aria-label="Copy file path">
      <svg class="document__copy-icon" data-clipboard-target="defaultIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>
      <svg class="document__copy-icon document__copy-icon--hidden" data-clipboard-target="successIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
    <button class="icon-button"
            type="button"
            data-action="click->rename#edit"
            data-tooltip="Rename"
            aria-label="Rename <%= document.display_name %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
    </button>
  </div>

  <%= form_with model: document,
                class: "document__rename-form",
                html: { hidden: true },
                data: { rename_target: "form", turbo_stream: true } do |form| %>
    <%= form.text_field :name,
                        value: document.display_name,
                        class: "document__rename-input input",
                        aria: { label: "File name" },
                        data: { rename_target: "input", action: "keydown.esc->rename#cancel" } %>
    <%= form.submit "Save", class: "document__save-button" %>
    <button type="button" class="document__cancel-button" data-action="click->rename#cancel">Cancel</button>
  <% end %>
</div>
