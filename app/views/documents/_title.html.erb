<div id="<%= dom_id(document, :title) %>" class="document__title-wrapper" data-controller="rename">
  <div class="document__title-display" data-rename-target="display">
    <%= render "application/file_badge", document: document %>

    <h1 class="document__title document__title--clickable"
        data-tooltip="Click to rename"
        data-action="click->rename#edit">
      <%= document.display_name %>
    </h1>

    <% if document.current_version %>
      <span class="document__version"><%= document.current_version.version %></span>
    <% end %>

    <button class="icon-button icon-button--sm document__hub-toggle"
            data-document-switcher-target="toggle"
            data-action="click->document-switcher#toggle"
            data-tooltip="Document info & recent files"
            type="button"
            aria-label="Switch file"
            aria-controls="document_switcher_panel"
            aria-expanded="false"
            aria-haspopup="menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>

  <%= form_with model: document,
                class: "document__rename-form",
                html: { hidden: true },
                data: { rename_target: "form", turbo_stream: true } do |form| %>
    <%= form.text_field :name,
                        value: document.display_name,
                        class: "document__rename-input input",
                        aria: { label: "File name" },
                        data: { rename_target: "input", action: "keydown.esc->rename#cancel" } %>
    <%= form.submit "Save", class: "document__save-button" %>
    <button type="button" class="document__cancel-button" data-action="click->rename#cancel">Cancel</button>
  <% end %>

  <%= render "documents/hub_panel", document: document, recent_documents: local_assigns[:recent_documents], editor_preference: local_assigns[:editor_preference] %>
</div>
