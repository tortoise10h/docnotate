<% content_for :body_class, "html-document-page" if @document.html? %>
<div class="<%= class_names("document", "document--wide": @document.html?, "document--markdown": !@document.html?) %>"
     data-controller="<%= class_names("scroll-to-top file-sidebar", "document-width": !@document.html?) %>">
  <header class="document__header">
    <div class="document__leading">
      <%= link_to root_path, class: "document__home-button" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Home</span>
      <% end %>
    </div>
    <div class="document__title-group" data-controller="document-switcher">
      <button class="icon-button icon-button--sm"
              data-document-switcher-target="toggle"
              data-action="click->document-switcher#toggle"
              data-tooltip="Switch file"
              type="button"
              aria-label="Switch file"
              aria-controls="document_switcher_panel"
              aria-expanded="false"
              aria-haspopup="menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6\"/></svg>
      </button>
      <%= render "application/file_badge", document: @document %>
      <%= render "documents/title", document: @document %>
      <div class="document__switcher-panel" id="document_switcher_panel" data-document-switcher-target="panel" hidden>
        <div class="document__switcher-header">
          <span class="document__switcher-heading">Recent files</span>
        </div>
        <ul class="document__switcher-list">
          <% @recent_documents.each do |document| %>
            <li>
              <%= link_to open_documents_path(file_path: document.file_path), class: "document__switcher-item" do %>
                <span class="document__switcher-name" data-tooltip="<%= document.file_path %>"><%= document.display_name %></span>
                <span class="document__switcher-time"><%= time_ago_in_words(document.last_opened_at) %> ago</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="document__actions">
      <%= render "width_toggle" unless @document.html? %>
      <%= render "editor_open", document: @document, editor_preference: @editor_preference %>
      <button class="icon-button document__scroll-top-button" data-scroll-to-top-target="button" data-action="click->scroll-to-top#scrollToTop" type="button" aria-label="Scroll to top">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
      </button>
    </div>
  </header>

  <%= render "table_of_contents", entries: @document.table_of_contents(@root_nodes), html: @document.html? %>

  <button class="document__sidebar-button"
          data-file-sidebar-target="toggle"
          data-action="click->file-sidebar#toggle"
          data-controller="hotkey"
          data-hotkey="Mod+b"
          data-tooltip="Browse files (⌘B)"
          type="button"
          aria-label="Browse files"
          aria-controls="document_sidebar"
          aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.53l-.42-.85a1 1 0 0 0-.9-.62H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M3 5v14a2 2 0 0 0 2 2h3"/><path d="M3 10h5"/></svg>
  </button>

  <% if @document.html? %>
    <%= render "documents/html_paper" %>
  <% else %>
    <%= render "documents/markdown_paper" %>
  <% end %>

  <%= render "filesystem/sidebar",
             id: "document_sidebar",
             frame_id: "document_sidebar_tree",
             path: File.dirname(@document.file_path),
             active_file_path: @document.file_path,
             extra_class: "document__sidebar" %>
</div>
