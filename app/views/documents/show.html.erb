<div class="document" data-controller="scroll-to-top">
  <header class="document__header">
    <%= link_to root_path, class: "document__home-button" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    <% end %>
    <div class="document__title-group">
      <h1 class="document__title" data-tooltip="<%= @document.file_path %>" data-action="click->scroll-to-top#scrollToTop"><%= File.basename(@document.file_path) %></h1>
      <button class="document__copy-button" data-controller="clipboard" data-clipboard-text-value="<%= @document.file_path %>" data-action="click->clipboard#copy" type="button" aria-label="Copy file path">
        <svg class="document__copy-icon" data-clipboard-target="defaultIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>
        <svg class="document__copy-icon document__copy-icon--hidden" data-clipboard-target="successIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </div>
    <span class="document__version"><%= @document.version %></span>
    <button class="document__scroll-top-button" data-scroll-to-top-target="button" data-action="click->scroll-to-top#scrollToTop" type="button" aria-label="Scroll to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
  </header>

  <div class="document__paper" id="document_paper"
       data-controller="text-selection comment-highlight comment-copy"
       data-action="comment-highlight:reload->comment-highlight#reloadFromSource
                   comment-highlight:reload->comment-copy#loadComments
                   comment-create:reset->text-selection#hideButton">
    <%= form_with url: document_comments_path(@document), class: "document__selection-form", data: { text_selection_target: "form" } do |f| %>
      <%= f.hidden_field :start_block_id, data: { text_selection_target: "startBlockId" } %>
      <%= f.hidden_field :end_block_id, data: { text_selection_target: "endBlockId" } %>
      <%= f.hidden_field :start_offset, data: { text_selection_target: "startOffset" } %>
      <%= f.hidden_field :end_offset, data: { text_selection_target: "endOffset" } %>
      <%= f.hidden_field :selected_text, data: { text_selection_target: "selectedText" } %>
      <%= f.hidden_field :prefix_text, data: { text_selection_target: "prefixText" } %>
      <%= f.hidden_field :postfix_text, data: { text_selection_target: "postfixText" } %>
      <button class="document__selection-button" data-text-selection-target="button" data-action="click->text-selection#showCommentInput" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        Add Note
      </button>
      <div class="document__comment-card" data-text-selection-target="commentInput">
        <%= f.text_area :content, placeholder: "Add your comment here...", class: "document__comment-textarea", data: { text_selection_target: "commentText", controller: "auto-resize-textarea", action: "input->auto-resize-textarea#resize" } %>
        <p class="document__comment-create-error" id="comment_create_error"></p>
        <div class="document__comment-actions">
          <button type="button" class="document__comment-cancel" data-action="click->text-selection#cancel">Cancel</button>
          <%= f.button type: "submit", class: "button" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            <span>Comment</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="document__comment-popover" data-comment-highlight-target="popover">
      <div class="document__comment-popover-header">
        <span class="document__comment-popover-date" data-comment-highlight-target="popoverDate"></span>
        <button type="button" class="document__comment-popover-close" data-action="click->comment-highlight#hidePopover" aria-label="Close">&times;</button>
      </div>
      <div class="document__comment-popover-body" data-comment-highlight-target="popoverBody"></div>
    </div>

    <div class="document__comment-nav" data-comment-highlight-target="nav">
      <button type="button" class="document__comment-nav-button" data-action="click->comment-highlight#previousComment" aria-label="Previous comment">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
      </button>
      <span class="document__comment-nav-count" aria-live="polite">
        <span data-comment-highlight-target="navCurrent">0</span>
        <span>/</span>
        <span data-comment-highlight-target="navTotal">0</span>
      </span>
      <button type="button" class="document__comment-nav-button" data-action="click->comment-highlight#nextComment" aria-label="Next comment">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="document__comment-nav-divider" data-comment-copy-target="divider" role="separator" aria-hidden="true"></div>
      <button type="button" class="document__comment-copy"
              data-comment-copy-target="button"
              data-action="click->comment-copy#copyComments"
              data-tooltip="Copy comments"
              aria-label="Copy comments">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>
      </button>
    </div>

    <script type="application/json" id="comment_payload_source"
            data-comment-highlight-target="source"
            data-comment-copy-target="source">
      <%= @comment_payload.to_json.html_safe %>
    </script>

    <div class="document__content" data-text-selection-target="content">
      <% @root_nodes.each do |root_node| %>
        <%= render "document_node", node: root_node %>
      <% end %>
    </div>
  </div>
</div>
