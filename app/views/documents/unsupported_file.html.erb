<div class="error">
  <header class="error__header">
    <%= image_tag "docnotate-logo.png", alt: "DocNotate", class: "error__logo", width: 48, height: 48 %>
    <h1 class="error__title">Unsupported file type</h1>
  </header>

  <p class="error__message">
    <strong><%= File.basename(@file_path) %></strong> is not a supported file.
  </p>
  <p class="error__hint">DocNotate currently supports <strong>.md</strong>, <strong>.markdown</strong>, <strong>.mdx</strong>, <strong>.html</strong>, and <strong>.htm</strong> files.</p>

  <%= link_to root_path, class: "button" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>Return to Home</span>
  <% end %>
</div>
