<%# locals: (result:, active_file_path: nil, frame_id: "filesystem_tree") %>
<% frame_id = local_assigns[:frame_id] || "filesystem_tree" %>
<% active_file_path = local_assigns[:active_file_path] %>

<turbo-frame id="<%= frame_id %>" class="file-tree">
  <div class="file-tree__header">
    <div class="file-tree__breadcrumbs" aria-label="Breadcrumb navigation">
      <% if result.parent_path.present? %>
        <%= link_to filesystem_path(path: result.parent_path, frame_id: frame_id, active_file_path: active_file_path),
                    class: "file-tree__up-button",
                    title: "Go to parent folder",
                    aria: { label: "Go to parent folder" },
                    data: { turbo_frame: frame_id } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <% end %>
      <% end %>

      <nav class="file-tree__breadcrumb-list">
        <% result.breadcrumbs.each_with_index do |crumb, idx| %>
          <% is_last = (idx == result.breadcrumbs.size - 1) %>
          <% if is_last %>
            <span class="file-tree__breadcrumb-item file-tree__breadcrumb-item--current" aria-current="page"><%= crumb[:name] %></span>
          <% else %>
            <%= link_to crumb[:name], filesystem_path(path: crumb[:path], frame_id: frame_id, active_file_path: active_file_path), class: "file-tree__breadcrumb-item", data: { turbo_frame: frame_id } %>
            <span class="file-tree__breadcrumb-separator" aria-hidden="true">/</span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <div class="file-tree__actions">
      <%= link_to filesystem_path(path: Dir.home, frame_id: frame_id, active_file_path: active_file_path),
                  class: "file-tree__action-button",
                  title: "Jump to Home (~)",
                  aria: { label: "Jump to Home (~)" },
                  data: { turbo_frame: frame_id } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <% end %>
    </div>
  </div>

  <div class="file-tree__content"
       data-controller="file-tree"
       data-file-tree-nodes-url-value="<%= nodes_filesystem_path %>"
       data-file-tree-active-path-value="<%= active_file_path %>">
    <% if result.entries.empty? %>
      <div class="file-tree__empty">
        <p>This directory is empty.</p>
      </div>
    <% else %>
      <%= render "filesystem/nodes", entries: result.entries, active_file_path: active_file_path %>
    <% end %>
  </div>
</turbo-frame>
