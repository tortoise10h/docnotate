<div class="home-settings" data-controller="settings">
  <button class="home-settings__button"
          data-settings-target="button"
          data-action="click->settings#toggle"
          type="button"
          aria-label="Settings"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-tooltip="Settings">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>

  <div class="home-settings__panel" data-settings-target="panel" hidden>
    <div class="home-settings__header">
      <span class="home-settings__heading">Settings</span>
    </div>
    <%= form_with url: settings_editor_path, method: :post, class: "home-settings__form", data: { settings_target: "form", action: "submit->settings#save" } do |form| %>
      <%= form.label :editor_name, "Open in editor app", class: "home-settings__label" %>
      <%= form.text_field :editor_name, value: (@editor_preference if @editor_preference.present? && @editor_preference != EditorOpener::DEFAULT), placeholder: "e.g. Visual Studio Code", class: "home-settings__input input", autocomplete: "off", data: { settings_target: "input" } %>
      <p class="home-settings__hint">App used when opening a file in your local editor. Choose "Use default app" to use your system default.</p>
      <p class="home-settings__error" data-settings-target="error" hidden></p>
      <div class="home-settings__actions">
        <button type="submit" name="editor_name" value="" class="button button--secondary">Use default app</button>
        <button type="submit" class="button">Save</button>
      </div>
    <% end %>
  </div>
</div>
