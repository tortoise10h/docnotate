<div class="home">
  <header class="home__header">
    <h1 class="home__title">
      <%= image_tag "docnotate-icon.svg", alt: "DocNotate", class: "home__logo", width: 32, height: 32 %>
      DocNotate
    </h1>
    <p class="home__subtitle">Read and annotate your documents with ease</p>
  </header>

  <section class="home__action">
    <%= form_with url: open_documents_path, method: :post, multipart: true, class: "home__form", data: { controller: "drop-zone" } do |form| %>
      <div class="drop-zone"
           data-action="dragenter->drop-zone#dragEnter dragover->drop-zone#dragOver dragleave->drop-zone#dragLeave drop->drop-zone#drop click->drop-zone#open">
        <div class="drop-zone__text">
          Drop a file here or click to browse
        </div>
        <div class="drop-zone__subtext">
          Supports .md, .markdown, .txt, .mdx
        </div>
        <%= form.file_field :file,
                           class: "file-input",
                           data: { drop_zone_target: "input", action: "change->drop-zone#submit" },
                           accept: ".md,.markdown,.txt,.mdx" %>
      </div>
    <% end %>
  </section>

  <section class="home__recent">
    <h2 class="section-title">Recent files</h2>
    <% if @recent_documents.any? %>
      <ul class="recent-files">
        <% @recent_documents.each do |document| %>
          <li class="recent-files__item">
            <%= link_to document_path(document), class: "recent-files__link" do %>
              <span class="recent-files__name"><%= File.basename(document.file_path) %></span>
              <span class="recent-files__time"><%= time_ago_in_words(document.last_opened_at) %> ago</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card card--transparent empty-state">
        <p>No recent files yet. Open a file to get started.</p>
      </div>
    <% end %>
  </section>
</div>
