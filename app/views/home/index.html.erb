<div class="home" data-controller="file-sidebar">
  <%= render "application/brand" %>

  <section class="home__action">
    <%= form_with url: open_documents_path, method: :get, class: "home__form" do |form| %>
      <div class="home__input-group">
        <button type="button"
                class="icon-button home__file-tree-button"
                data-file-sidebar-target="toggle"
                data-action="click->file-sidebar#toggle"
                data-controller="hotkey"
                data-hotkey="Mod+b"
                aria-label="Browse files"
                aria-controls="home_sidebar"
                aria-expanded="false"
                data-tooltip="Browse files (⌘B)">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.53l-.42-.85a1 1 0 0 0-.9-.62H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M3 5v14a2 2 0 0 0 2 2h3"/><path d="M3 10h5"/></svg>
        </button>
        <%= form.text_field :file_path,
                            placeholder: "Enter local file path",
                            class: "home__input",
                            autocomplete: "off",
                            data: {
                              controller: "autofocus file-input",
                              action: "paste->file-input#handlePaste input->file-input#handleInput"
                            } %>
        <%= form.button type: :submit, class: "button home__button" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
          <span>Open</span>
        <% end %>
      </div>
    <% end %>
    <p class="home__hint">Supports .md, .markdown, .mdx, .html, .htm</p>
  </section>

  <section class="home__recent">
    <div class="home__recent-header">
      <h2 class="section-title">Recent files</h2>
      <%= link_to documents_path, class: "home__all-files", aria: { label: "View all files" }, data: { tooltip: "View all files" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
      <% end %>
    </div>
    <% if @recent_documents.any? %>
      <ul class="recent-files">
        <% @recent_documents.each do |document| %>
          <li class="recent-files__item">
            <%= link_to open_documents_path(file_path: document.file_path), class: "recent-files__link" do %>
              <span class="recent-files__file">
                <%= render "application/file_badge", document: document %>
                <span class="recent-files__name" data-tooltip="<%= document.file_path %>"><%= document.display_name %></span>
              </span>
              <span class="recent-files__time"><%= time_ago_in_words(document.last_opened_at) %> ago</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card card--transparent empty-state">
        <p>No recent files yet. Open a file to get started.</p>
      </div>
    <% end %>
  </section>

  <%= render "settings" %>

  <%= render "filesystem/sidebar",
             id: "home_sidebar",
             frame_id: "home_sidebar_tree",
             path: Dir.home %>
</div>
